<ui:FluentWindow x:Class="FlowClicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FlowClicker"
        Icon="Assets/FlowClicker.ico"
        Height="720" Width="1020"
        MinHeight="600" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        UseLayoutRounding="True"
        ExtendsContentIntoTitleBar="True"
        Topmost="{Binding Settings.IsAlwaysOnTop}">

    <ui:FluentWindow.Resources>
        <Style x:Key="NavigationKeyboardFocus" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border CornerRadius="6"
                                Background="{DynamicResource SubtleFillColorTertiaryBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavigationItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="NavGroup" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource NavigationKeyboardFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBackground" Background="Transparent" CornerRadius="6"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter Margin="14,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBackground" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBackground" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavBackground" Property="Background"
                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Windows 11 TitleBar with Snap Layout support -->
        <ui:TitleBar Title="FlowClicker" Padding="16,0,0,0">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="Assets/FlowClicker.png" Width="20" Height="20" Margin="0,0,6,0" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar (Windows 11 Fluent Style) -->
            <Border Padding="8,8,4,8">
                <Grid x:Name="NavigationPane" SizeChanged="OnNavigationPaneSizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <RadioButton x:Name="NavAutoClicker" Style="{StaticResource NavigationItem}"
                                     Click="OnNavClick" AutomationProperties.Name="Auto Clicker" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Style="{StaticResource WindowsIcon}" Glyph="&#xE945;" Margin="0,0,12,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <ui:TextBlock Text="Auto Clicker" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavMultiPoint" Style="{StaticResource NavigationItem}"
                                     Click="OnNavClick" AutomationProperties.Name="Multi-Point">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Style="{StaticResource WindowsIcon}" Glyph="&#xF272;" Margin="0,0,12,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <ui:TextBlock Text="Multi-Point" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavMouseTools" Style="{StaticResource NavigationItem}"
                                     Click="OnNavClick" AutomationProperties.Name="Mouse Tools">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Style="{StaticResource WindowsIcon}" Glyph="&#xE962;" Margin="0,0,12,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <ui:TextBlock Text="Mouse Tools" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavigationItem}"
                                     Click="OnNavClick" AutomationProperties.Name="Settings">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Style="{StaticResource WindowsIcon}" Glyph="&#xE713;" Margin="0,0,12,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <ui:TextBlock Text="Settings" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <Border Grid.RowSpan="2" Width="3" Height="16" CornerRadius="2"
                            HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                            RenderTransformOrigin="0.5,0.5"
                            Background="{DynamicResource AccentTextFillColorPrimaryBrush}">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="SelectionScale" />
                                <TranslateTransform x:Name="SelectionOffset" Y="12" />
                            </TransformGroup>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" ClipToBounds="True">
                <Grid x:Name="PageHost" MaxWidth="1100" />
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
