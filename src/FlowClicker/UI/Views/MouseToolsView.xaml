<UserControl x:Class="FlowClicker.UI.Views.MouseToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:services="clr-namespace:FlowClicker.Core.Services"
             xmlns:models="clr-namespace:FlowClicker.Core.Services.Models"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,24">
        <StackPanel>
            <TextBlock Text="Mouse Tools" Style="{StaticResource PageHeading}" />
            <ui:InfoBar Title="Mouse tool action failed"
                        Message="{Binding FailureMessage}"
                        IsOpen="{Binding InputFailed}"
                        IsClosable="False"
                        Severity="Error"
                        Margin="0,0,0,12" />
            <TextBlock Text="Pointer and scrolling" Style="{StaticResource SectionHeading}" />

            <!-- 1. Auto-Scroll Tool Card -->
            <Border Style="{StaticResource SectionCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel IsEnabled="{Binding IsAutoScrollRunning, Converter={StaticResource InverseBooleanConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:FontIcon Style="{StaticResource WindowsIcon}" Glyph="&#xE8CB;" FontSize="20" Margin="0,0,8,0" />
                            <ui:TextBlock Text="Auto-scroll" FontTypography="BodyStrong" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Border CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#22888888" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAutoScrollRunning}" Value="True">
                                                <Setter Property="Background" Value="#266CCB5F" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontWeight="SemiBold" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Idle" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAutoScrollRunning}" Value="True">
                                                    <Setter Property="Text" Value="Scrolling" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,12,0">
                                <ui:TextBlock Text="Direction" FontTypography="Caption" />
                                <ComboBox SelectedValue="{Binding ScrollDirection, Mode=TwoWay}"
                                          SelectedValuePath="Tag"
                                          Margin="0,6,0,0"
                                          HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Down" Tag="{x:Static services:ScrollDirection.Down}" />
                                    <ComboBoxItem Content="Up" Tag="{x:Static services:ScrollDirection.Up}" />
                                    <ComboBoxItem Content="Right" Tag="{x:Static services:ScrollDirection.Right}" />
                                    <ComboBoxItem Content="Left" Tag="{x:Static services:ScrollDirection.Left}" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <ui:TextBlock Text="Steps per second" FontTypography="Caption" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="1" Maximum="100" Value="{Binding ScrollSpeed, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <ui:TextBlock Grid.Column="1" Text="{Binding ScrollSpeed}" FontTypography="Caption" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Start/Stop Auto-Scroll Button -->
                    <ui:Button Grid.Column="1"
                               Command="{Binding ToggleAutoScrollCommand}"
                               Width="140"
                               Height="38"
                               CornerRadius="4"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Primary" />
                                <Setter Property="Content" Value="Start scroll" />
                                <Setter Property="Icon" Value="{ui:FontIcon '&#xE768;', FontFamily='Segoe Fluent Icons, Segoe MDL2 Assets', FontSize=15}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAutoScrollRunning}" Value="True">
                                        <Setter Property="Appearance" Value="Danger" />
                                        <Setter Property="Content" Value="Stop scroll" />
                                        <Setter Property="Icon" Value="{ui:FontIcon '&#xE71A;', FontFamily='Segoe Fluent Icons, Segoe MDL2 Assets', FontSize=15}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </Grid>
            </Border>

            <!-- 2. Mouse Jiggler Card -->
            <Border Style="{StaticResource SectionCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel IsEnabled="{Binding IsJigglerRunning, Converter={StaticResource InverseBooleanConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:FontIcon Style="{StaticResource WindowsIcon}" Glyph="&#xE962;" FontSize="20" Margin="0,0,8,0" />
                            <ui:TextBlock Text="Mouse jiggler" FontTypography="BodyStrong" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Border CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#22888888" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsJigglerRunning}" Value="True">
                                                <Setter Property="Background" Value="#266CCB5F" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontWeight="SemiBold" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Idle" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsJigglerRunning}" Value="True">
                                                    <Setter Property="Text" Value="Active" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <ui:TextBlock Text="Moves the pointer at the selected interval." TextWrapping="Wrap"
                                      FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Margin="0,0,0,12" />

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,12,0">
                                <ui:TextBlock Text="Movement" FontTypography="Caption" />
                                <ComboBox SelectedValue="{Binding JigglerMode, Mode=TwoWay}"
                                          SelectedValuePath="Tag"
                                          Margin="0,6,0,0"
                                          HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Smooth curve" Tag="{x:Static services:JigglerMode.Lissajous}" />
                                    <ComboBoxItem Content="1-pixel nudge" Tag="{x:Static services:JigglerMode.MicroNudge}" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <ui:TextBlock Text="Interval" FontTypography="Caption" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="2" Maximum="120" Value="{Binding JigglerInterval, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <ui:TextBlock Grid.Column="1" Text="{Binding JigglerInterval, StringFormat='{}{0}s'}" FontTypography="Caption" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Start/Stop jiggler Button -->
                    <ui:Button Grid.Column="1"
                               Command="{Binding ToggleJigglerCommand}"
                               Width="140"
                               Height="38"
                               CornerRadius="4"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Primary" />
                                <Setter Property="Content" Value="Start jiggler" />
                                <Setter Property="Icon" Value="{ui:FontIcon '&#xE768;', FontFamily='Segoe Fluent Icons, Segoe MDL2 Assets', FontSize=15}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsJigglerRunning}" Value="True">
                                        <Setter Property="Appearance" Value="Danger" />
                                        <Setter Property="Content" Value="Stop jiggler" />
                                        <Setter Property="Icon" Value="{ui:FontIcon '&#xE71A;', FontFamily='Segoe Fluent Icons, Segoe MDL2 Assets', FontSize=15}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </Grid>
            </Border>

            <TextBlock Text="Mouse buttons" Style="{StaticResource SectionHeading}" Margin="0,12,0,8" />
            <Border Style="{StaticResource SectionCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel IsEnabled="{Binding IsHoldLockActive, Converter={StaticResource InverseBooleanConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:FontIcon Style="{StaticResource WindowsIcon}" Glyph="&#xE72E;" FontSize="20" Margin="0,0,8,0" />
                            <ui:TextBlock Text="Hold a mouse button" FontTypography="BodyStrong" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Border CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#22888888" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHoldLockActive}" Value="True">
                                                <Setter Property="Background" Value="#266CCB5F" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontWeight="SemiBold" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Released" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHoldLockActive}" Value="True">
                                                    <Setter Property="Text" Value="Holding" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <ui:TextBlock Text="Press Shift + Esc to release." TextWrapping="Wrap"
                                      FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Margin="0,0,0,12" />

                        <ComboBox SelectedValue="{Binding HoldButton, Mode=TwoWay}"
                                  SelectedValuePath="Tag"
                                  Width="200"
                                  HorizontalAlignment="Left"
                                  Margin="0,4,0,0">
                            <ComboBoxItem Content="Left Button" Tag="{x:Static models:ClickMouseButton.Left}" />
                            <ComboBoxItem Content="Right Button" Tag="{x:Static models:ClickMouseButton.Right}" />
                            <ComboBoxItem Content="Middle Button" Tag="{x:Static models:ClickMouseButton.Middle}" />
                            <ComboBoxItem Content="XButton 1 (Back)" Tag="{x:Static models:ClickMouseButton.XButton1}" />
                            <ComboBoxItem Content="XButton 2 (Forward)" Tag="{x:Static models:ClickMouseButton.XButton2}" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Toggle Hold Lock Button -->
                    <ui:Button Grid.Column="1"
                               Command="{Binding ToggleHoldLockCommand}"
                               Width="140"
                               Height="38"
                               CornerRadius="4"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Primary" />
                                <Setter Property="Content" Value="Hold button" />
                                <Setter Property="Icon" Value="{ui:FontIcon '&#xE72E;', FontFamily='Segoe Fluent Icons, Segoe MDL2 Assets', FontSize=15}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHoldLockActive}" Value="True">
                                        <Setter Property="Appearance" Value="Danger" />
                                        <Setter Property="Content" Value="Release button" />
                                        <Setter Property="Icon" Value="{ui:FontIcon '&#xE785;', FontFamily='Segoe Fluent Icons, Segoe MDL2 Assets', FontSize=15}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
