<Window x:Class="FlowClicker.UI.Views.CoordinatePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coordinate Picker"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="#01000000"
        Topmost="True"
        Cursor="Cross"
        KeyDown="OnKeyDown"
        MouseDown="OnMouseDown"
        MouseMove="OnMouseMove">
    <Canvas x:Name="OverlayCanvas">
        <Border x:Name="CoordBadge"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Background="#DC111418"
                CornerRadius="6"
                Padding="10,6"
                BorderBrush="#66FFFFFF"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.45" Color="#000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="#3B82F6" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="CoordText"
                           Text="X: 0, Y: 0"
                           Foreground="#FFFFFF"
                           FontFamily="Segoe UI Variable Text"
                           FontSize="13"
                           FontWeight="SemiBold"/>
                <TextBlock Text=" (Click, Enter, or F7 to select, Esc to cancel)"
                           Foreground="#C4C9D4"
                           FontFamily="Segoe UI Variable Text"
                           FontSize="11"
                           Margin="6,1,0,0"/>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
