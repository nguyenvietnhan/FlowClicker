<UserControl x:Class="FlowClicker.UI.Views.MultiPointView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:FlowClicker.Core.Services.Models"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="MouseButtonValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ClickMouseButton" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ClickTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ClickType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <Grid Margin="24,16,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Multi-Point" Style="{StaticResource PageHeading}" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource RunStatusDot}" />
                    <TextBlock Style="{StaticResource RunStatus}" />
                </StackPanel>
            </StackPanel>
            <ui:Button Grid.Column="1"
                       Command="{Binding ToggleSequenceCommand}"
                       MinWidth="148"
                       Height="38" VerticalAlignment="Center"
                       CornerRadius="4">
                <ui:Button.Style>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                        <Setter Property="Appearance" Value="Primary" />
                        <Setter Property="Content" Value="Run Sequence (F8)" />
                        <Setter Property="Icon" Value="{ui:FontIcon '&#xE768;', FontFamily='Segoe Fluent Icons, Segoe MDL2 Assets', FontSize=16}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="Appearance" Value="Danger" />
                                <Setter Property="Content" Value="Stop Sequence (F8)" />
                                <Setter Property="Icon" Value="{ui:FontIcon '&#xE71A;', FontFamily='Segoe Fluent Icons, Segoe MDL2 Assets', FontSize=16}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Button.Style>
            </ui:Button>
        </Grid>

        <ui:InfoBar Grid.Row="1"
                    Title="Sequence action failed"
                    Message="{Binding FailureMessage}"
                    IsOpen="{Binding InputFailed}"
                    IsClosable="False"
                    Severity="Error"
                    Margin="0,0,0,8" />

        <!-- Coordinate List Card -->
        <Border Grid.Row="2" Style="{StaticResource SectionCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <WrapPanel Margin="0,0,0,8"
                           IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}">
                    <WrapPanel.Resources>
                        <Style x:Key="SequenceToolButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Appearance" Value="Transparent" />
                            <Setter Property="Padding" Value="7,6" />
                            <Setter Property="MinHeight" Value="32" />
                            <Setter Property="Margin" Value="0,0,4,4" />
                        </Style>
                    </WrapPanel.Resources>
                    <ui:Button Command="{Binding PickAndAddPointCommand}"
                               Content="Pick point (F7)"
                               Style="{StaticResource SequenceToolButton}">
                        <ui:Button.Icon>
                            <ui:FontIcon Style="{StaticResource WindowsIcon}" Glyph="&#xF272;" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Command="{Binding AddPointCommand}"
                               Content="Add step"
                               Style="{StaticResource SequenceToolButton}">
                        <ui:Button.Icon>
                            <ui:FontIcon Style="{StaticResource WindowsIcon}" Glyph="&#xE710;" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Command="{Binding MoveUpCommand}"
                               Content="Move up"
                               Style="{StaticResource SequenceToolButton}">
                        <ui:Button.Icon>
                            <ui:FontIcon Style="{StaticResource WindowsIcon}" Glyph="&#xE74A;" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Command="{Binding MoveDownCommand}"
                               Content="Move down"
                               Style="{StaticResource SequenceToolButton}">
                        <ui:Button.Icon>
                            <ui:FontIcon Style="{StaticResource WindowsIcon}" Glyph="&#xE74B;" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Command="{Binding RemovePointCommand}"
                               Content="Remove"
                               Style="{StaticResource SequenceToolButton}">
                        <ui:Button.Icon>
                            <ui:FontIcon Style="{StaticResource WindowsIcon}" Glyph="&#xE74D;" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Command="{Binding ClearCommand}"
                               Content="Clear all"
                               Style="{StaticResource SequenceToolButton}">
                        <ui:Button.Icon>
                            <ui:FontIcon Style="{StaticResource WindowsIcon}" Glyph="&#xE711;" />
                        </ui:Button.Icon>
                    </ui:Button>
                </WrapPanel>

                <!-- Points DataGrid -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Points}"
                          SelectedItem="{Binding SelectedPoint, Mode=TwoWay}"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          ColumnHeaderHeight="36"
                          CanUserResizeColumns="True"
                          Loaded="OnPointsGridLoaded"
                          RowHeight="36"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                          Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="38" IsReadOnly="True" />
                        <DataGridTextColumn Header="X (px)" Binding="{Binding X, UpdateSourceTrigger=PropertyChanged}" Width="72" />
                        <DataGridTextColumn Header="Y (px)" Binding="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Width="72" />
                        <DataGridTextColumn Header="Before (ms)" Binding="{Binding PreDelayMs, UpdateSourceTrigger=PropertyChanged}" Width="96" />
                        <DataGridTextColumn Header="After (ms)" Binding="{Binding PostDelayMs, UpdateSourceTrigger=PropertyChanged}" Width="92" />
                        <DataGridComboBoxColumn Header="Button"
                                                ItemsSource="{Binding Source={StaticResource MouseButtonValues}}"
                                                SelectedItemBinding="{Binding Button, UpdateSourceTrigger=PropertyChanged}"
                                                Width="92" />
                        <DataGridComboBoxColumn Header="Type"
                                                ItemsSource="{Binding Source={StaticResource ClickTypeValues}}"
                                                SelectedItemBinding="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                                Width="80" />
                        <DataGridTextColumn Header="Label" Binding="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Comment}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNoPoints}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ui:FontIcon Style="{StaticResource WindowsIcon}" Glyph="&#xF272;" FontSize="24"
                                 Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,8" />
                    <ui:TextBlock Text="No sequence steps yet" FontTypography="BodyStrong"
                                  HorizontalAlignment="Center"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Text="Use Pick point (F7) or Add step above to create a click sequence."
                                  FontTypography="Caption" HorizontalAlignment="Center" Margin="0,2,0,0"
                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sequence Options & Status Card -->
        <Border Grid.Row="3" Style="{StaticResource SectionCard}" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}">
                    <ui:TextBlock Text="Repeats" FontTypography="Body" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ui:NumberBox Value="{Binding RepeatCount, Mode=TwoWay, Converter={StaticResource NumberValueConverter}, ConverterParameter=0}"
                                  Minimum="0"
                                  MaxDecimalPlaces="0"
                                  SpinButtonPlacementMode="Compact"
                                  Width="96"
                                  Margin="0,0,8,0" />
                    <ui:TextBlock Text="0 = continuous" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <ui:TextBlock Text="Step" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
                    <ui:TextBlock Text="{Binding DisplayStep}" FontTypography="BodyStrong" Margin="0,0,16,0" />

                    <ui:TextBlock Text="Cycles" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
                    <ui:TextBlock Text="{Binding CompletedCycles}" FontTypography="BodyStrong" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
