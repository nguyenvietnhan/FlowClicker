<UserControl x:Class="FlowClicker.UI.Views.MultiPointView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800">
    <Grid Margin="24,16,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Multi-Point" Style="{StaticResource PageHeading}" Margin="0" />
                <TextBlock Style="{StaticResource RunStatus}" />
            </StackPanel>
            <ui:Button Grid.Column="1"
                       Command="{Binding ToggleSequenceCommand}"
                       MinWidth="128"
                       Height="38" VerticalAlignment="Center"
                       CornerRadius="4">
                <ui:Button.Style>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                        <Setter Property="Appearance" Value="Primary" />
                        <Setter Property="Content" Value="Run Sequence" />
                        <Setter Property="Icon" Value="{ui:FontIcon '&#xE768;', FontFamily='Segoe Fluent Icons, Segoe MDL2 Assets', FontSize=16}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="Appearance" Value="Danger" />
                                <Setter Property="Content" Value="Stop Sequence" />
                                <Setter Property="Icon" Value="{ui:FontIcon '&#xE71A;', FontFamily='Segoe Fluent Icons, Segoe MDL2 Assets', FontSize=16}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Button.Style>
            </ui:Button>
        </Grid>

        <!-- Coordinate List Card -->
        <Border Grid.Row="1" Style="{StaticResource SectionCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <WrapPanel Margin="0,0,0,8">
                    <WrapPanel.Resources>
                        <Style x:Key="SequenceToolButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Appearance" Value="Transparent" />
                            <Setter Property="Padding" Value="7,6" />
                            <Setter Property="MinHeight" Value="32" />
                            <Setter Property="Margin" Value="0,0,4,4" />
                        </Style>
                    </WrapPanel.Resources>
                    <ui:Button Command="{Binding PickAndAddPointCommand}"
                               Content="Pick point"
                               Style="{StaticResource SequenceToolButton}">
                        <ui:Button.Icon>
                            <ui:FontIcon Style="{StaticResource WindowsIcon}" Glyph="&#xF272;" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Command="{Binding AddPointCommand}"
                               Content="Add step"
                               Style="{StaticResource SequenceToolButton}">
                        <ui:Button.Icon>
                            <ui:FontIcon Style="{StaticResource WindowsIcon}" Glyph="&#xE710;" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Command="{Binding MoveUpCommand}"
                               Content="Move up"
                               Style="{StaticResource SequenceToolButton}">
                        <ui:Button.Icon>
                            <ui:FontIcon Style="{StaticResource WindowsIcon}" Glyph="&#xE74A;" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Command="{Binding MoveDownCommand}"
                               Content="Move down"
                               Style="{StaticResource SequenceToolButton}">
                        <ui:Button.Icon>
                            <ui:FontIcon Style="{StaticResource WindowsIcon}" Glyph="&#xE74B;" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Command="{Binding RemovePointCommand}"
                               Content="Remove"
                               Style="{StaticResource SequenceToolButton}">
                        <ui:Button.Icon>
                            <ui:FontIcon Style="{StaticResource WindowsIcon}" Glyph="&#xE74D;" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Command="{Binding ClearCommand}"
                               Content="Clear all"
                               Style="{StaticResource SequenceToolButton}">
                        <ui:Button.Icon>
                            <ui:FontIcon Style="{StaticResource WindowsIcon}" Glyph="&#xE711;" />
                        </ui:Button.Icon>
                    </ui:Button>
                </WrapPanel>

                <!-- Points DataGrid -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Points}"
                          SelectedItem="{Binding SelectedPoint, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          CanUserResizeColumns="False"
                          Loaded="OnPointsGridLoaded"
                          RowHeight="36"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                          Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="36" IsReadOnly="True" />
                        <DataGridTextColumn Header="X (px)" Binding="{Binding X}" Width="56" />
                        <DataGridTextColumn Header="Y (px)" Binding="{Binding Y}" Width="56" />
                        <DataGridTextColumn Header="Before (ms)" Binding="{Binding PreDelayMs}" Width="104" />
                        <DataGridTextColumn Header="After (ms)" Binding="{Binding PostDelayMs}" Width="96" />
                        <DataGridTextColumn Header="Button" Binding="{Binding Button}" Width="80" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70" />
                        <DataGridTextColumn Header="Label" Binding="{Binding Comment}" Width="*" MinWidth="108">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Comment}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Sequence Options & Status Card -->
        <Border Grid.Row="2" Style="{StaticResource SectionCard}" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBlock Text="Repeats" FontTypography="Body" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ui:NumberBox Value="{Binding RepeatCount, Mode=TwoWay}"
                                  Minimum="0"
                                  Width="90"
                                  Margin="0,0,8,0" />
                    <ui:TextBlock Text="0 = continuous" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <ui:TextBlock Text="Step" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
                    <ui:TextBlock Text="{Binding CurrentStepIndex}" FontTypography="BodyStrong" Margin="0,0,16,0" />

                    <ui:TextBlock Text="Cycles" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
                    <ui:TextBlock Text="{Binding CompletedCycles}" FontTypography="BodyStrong" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
